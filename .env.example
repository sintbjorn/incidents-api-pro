DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/incidents
API_KEY=                                #простая авторизация по ключу (по желанию- выключено по умолчанию)

# Notification Service integration for CRITICAL incidents
NOTIFICATION_SERVICE_URL=               # например http://notification-service:8000
NOTIFICATION_SERVICE_API_KEY=
NOTIFICATION_CHANNEL=telegram           # telegram | email | sms
NOTIFICATION_TIMEOUT_SECONDS=5

#  Telegram bot 
TELEGRAM_BOT_TOKEN=123456:ABC...        # токен бота
TELEGRAM_CHAT_ID=-1001234567890         # ID целевого чата (можно перечислить через запятую)

#  Связь бота с API 
API_URL=http://api:8000                 # адрес API с точки зрения docker-compose
# API_KEY=                              
